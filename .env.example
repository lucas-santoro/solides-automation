# Credenciais do perfil Colaborador (as mesmas da aba "Colaborador" na tela de login)
SOLIDES_CODIGO_EMPREGADOR=
SOLIDES_PIN=

# Senha usada somente na página de autorização OAuth (mínimo 24 caracteres).
# O cliente MCP recebe tokens temporários após o login; nunca recebe esta senha.
# Obrigatória só para o servidor (solides-mcp); a CLI (solides) não usa.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SOLIDES_MCP_TOKEN=

# Opcionais (os valores abaixo são os padrões)
# SOLIDES_BASE_URL=https://app.tangerino.com.br/Tangerino/
# SOLIDES_HEADLESS=true
# SOLIDES_TIMEOUT_MS=30000
# SOLIDES_ARTIFACTS_DIR=artifacts
# SOLIDES_MCP_HOST=127.0.0.1
# SOLIDES_MCP_PORT=8000
# URL pública da origem OAuth, sem /mcp. Obrigatória para acesso externo via HTTPS.
# SOLIDES_MCP_PUBLIC_URL=https://ponto.seudominio.com

# Valores aceitos no header Host, separados por vírgula. Ativa a proteção contra DNS rebinding
# quando o servidor escuta fora do localhost. Ex.: ponto.seudominio.com,192.168.0.10:*
# SOLIDES_MCP_ALLOWED_HOSTS=
